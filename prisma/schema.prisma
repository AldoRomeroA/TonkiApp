enum UserStatus {
  active
  suspended
}

enum RewardStatus {
  active
  redeemed
  expired
}

datasource db {
  //fk it me rendi, no se podia realizar la coneccion con hostinger incluso cambiando los caracteres a Ascii y todo
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  // Cambie user-id a 36 char por los -
  user_id        String    @id @default(uuid()) @db.Char(36)
  // Quite que el email fuera unico igual que la wallet temporalmente para pruebas
  email          String?   @db.VarChar(100)
  name           String    @db.VarChar(100)
  wallet_address String?
  age            Int?
  birth_date     DateTime?
  type           String    @db.VarChar(100)
  status         String    @default("active")
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  credentials         Credential[]
  auth_identities     AuthIdentity[]
  smart_wallets       SmartWallet[]
  passkey_credentials PasskeyCredential[]
  establishments      Establishment[]
  rewards             Reward[]
  airdrop_configs     AirdropConfig[]
  posts               Post[]
}

model AuthIdentity {
  identity_id      String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  provider         String   @db.VarChar(50)
  provider_subject String   @db.VarChar(255)
  email            String?  @db.VarChar(255)
  email_verified   Boolean  @default(false)
  display_name     String?  @db.VarChar(255)
  avatar_url       String?  @db.VarChar(2048)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id])

  @@unique([provider, provider_subject])
  @@index([user_id])
  @@index([email])
}

model SmartWallet {
  wallet_id        String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  network          String   @db.VarChar(50)
  contract_address String   @db.VarChar(100)
  status           String   @default("pending") @db.VarChar(50)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user                User                @relation(fields: [user_id], references: [user_id])
  passkey_credentials PasskeyCredential[]

  @@unique([network, contract_address])
  @@unique([user_id, network])
  @@index([user_id])
}

model PasskeyCredential {
  passkey_credential_id String    @id @default(uuid()) @db.Char(36)
  user_id               String    @db.Char(36)
  wallet_id             String?   @db.Char(36)
  credential_id         String    @unique @db.VarChar(512)
  public_key            String    @db.Text
  public_key_algorithm  Int?
  sign_count            BigInt    @default(0)
  transports            Json?
  device_label          String?   @db.VarChar(100)
  last_used_at          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  user   User         @relation(fields: [user_id], references: [user_id])
  wallet SmartWallet? @relation(fields: [wallet_id], references: [wallet_id])

  @@index([user_id])
  @@index([wallet_id])
}

model Post {
  post_id            String    @id @default(uuid()) @db.Char(36)
  author_id          String    @db.Char(36)
  title              String    @db.VarChar(500)
  body               String?   @db.Text
  view_count         Int       @default(0)
  share_count        Int       @default(0)
  content_edited_at  DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  author       User             @relation(fields: [author_id], references: [user_id])
  attachments  PostAttachment[]

  @@index([created_at(sort: Desc), post_id(sort: Asc)])
  @@index([author_id, created_at(sort: Desc), post_id(sort: Asc)])
}

model PostAttachment {
  attachment_id String  @id @default(uuid()) @db.Char(36)
  post_id       String  @db.Char(36)
  url           String  @db.VarChar(2048)
  mime_type     String  @db.VarChar(255)
  original_name String? @db.VarChar(255)

  post Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)

  @@index([post_id])
}

model Credential {
  credential_id String   @id @default(uuid()) @db.Char(36)
  user_id       String   @db.Char(36)
  username      String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(256)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id])
}

model Establishment {
  establishment_id String   @id @default(uuid()) @db.Char(36)
  admin_id         String   @db.Char(36)
  name             String   @db.VarChar(150)
  address          String?  @db.VarChar(255)
  category         String?  @db.VarChar(100)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  admin   User     @relation(fields: [admin_id], references: [user_id])
  rewards Reward[]
}

model Reward {
  reward_id        String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  establishment_id String   @db.Char(36)
  title            String   @db.VarChar(150)
  description      String?
  points           Int      @default(0)
  status           String   @default("active")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user          User          @relation(fields: [user_id], references: [user_id])
  establishment Establishment @relation(fields: [establishment_id], references: [establishment_id])
}

model AirdropConfig {
  config_id          String   @id @default(uuid()) @db.Char(36)
  user_id            String   @db.Char(36)
  amount             Float
  scheduled_date     DateTime
  periodicity_months Int
  max_users          Int
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user User         @relation(fields: [user_id], references: [user_id])
  logs AirdropLog[]
}

model AirdropLog {
  log_id           String   @id @default(uuid()) @db.Char(36)
  config_id        String   @db.Char(36)
  transaction_hash String?  @db.VarChar(100)
  total_amount     Float
  users_involved   Int
  executed_at      DateTime @default(now())
  success          Boolean  @default(true)
  error_message    String?  @db.VarChar(255)
  response_json    String?

  config AirdropConfig @relation(fields: [config_id], references: [config_id])
}
