enum UserStatus {
  active
  suspended
}

enum RewardStatus {
  active
  redeemed
  expired
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  user_id        String   @id @default(uuid()) @db.Char(32)
  email          String   @unique @db.VarChar(100)
  name           String   @db.VarChar(100)
  wallet_address String?  @unique
  age            Int?
  birth_date     DateTime?
  type           String   @db.VarChar(100)
  status         String   @default("active")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  credentials     Credential[]
  establishments  Establishment[]
  rewards         Reward[]
  airdrop_configs AirdropConfig[]
}

model Credential {
  credential_id String   @id @default(uuid()) @db.Char(32)
  user_id       String   @db.Char(32)
  username      String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(256)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id])
}

model Establishment {
  establishment_id String   @id @default(uuid()) @db.Char(32)
  admin_id         String   @db.Char(32)
  name             String   @db.VarChar(150)
  address          String?  @db.VarChar(255)
  category         String?  @db.VarChar(100)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  admin     User      @relation(fields: [admin_id], references: [user_id])
  rewards   Reward[]
}

model Reward {
  reward_id       String   @id @default(uuid()) @db.Char(32)
  user_id         String   @db.Char(32)
  establishment_id String  @db.Char(32)
  title           String   @db.VarChar(150)
  description     String?
  points          Int      @default(0)
  status          String   @default("active")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user          User          @relation(fields: [user_id], references: [user_id])
  establishment Establishment @relation(fields: [establishment_id], references: [establishment_id])
}

model AirdropConfig {
  config_id          String   @id @default(uuid()) @db.Char(32)
  user_id            String   @db.Char(32)
  amount             Float
  scheduled_date     DateTime
  periodicity_months Int
  max_users          Int
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id])
  logs AirdropLog[]
}

model AirdropLog {
  log_id          String   @id @default(uuid()) @db.Char(32)
  config_id       String   @db.Char(32)
  transaction_hash String? @db.VarChar(100)
  total_amount    Float
  users_involved  Int
  executed_at     DateTime @default(now())
  success         Boolean  @default(true)
  error_message   String?  @db.VarChar(255)
  response_json   String?

  config AirdropConfig @relation(fields: [config_id], references: [config_id])
}